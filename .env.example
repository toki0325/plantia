# 楽天商品画像取得（scripts/rakuten-fetch-item.mjs）
# nookinterior と同じ Application ID / Access Key を .env.local にコピー可
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_REFERER_URL=

# KOMOJU（値は入れない。本番は Netlify の環境変数へ）
KOMOJU_SECRET_KEY=
KOMOJU_WEBHOOK_SECRET=

# 本番ドメインが決まったら設定し、Functions スコープで再デプロイする
# KOMOJU_RETURN_BASE_URL=https://plantia-garden.com
# KOMOJU_IMAGE_BASE_URL=https://plantia-garden.com
